@model List<ProductionSystem.Domain.DTOs.PersonnelDto>

@{
    ViewData["Title"] = "پرسنل";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("اطلاعات پایه", "#"),
        ("پرسنل", "/Personnel/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست پرسنل</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس عنوان ، کد ،یا شماره موبایل..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    <button class="btn btn-primary" onclick="openCreateModal()">+ تعریف پرسنل</button>
</div>

<table class="table table-bordered table-hover" id="PersonnelTable">
    <thead>
    <tr>
        <th>ردیف</th>
        <th>عنوان</th>
        <th>کد</th>
        <th>شماره موبایل</th>
        <th>عملیات</th>
    </tr>
    </thead>
    <tbody>
    @{
        int row = 1;
    }
    @foreach (var p in Model)
    {
        <tr>
            <td>@(row++)</td>
            <td>@p.Title</td>
            <td>@p.Code</td>
            <td>@p.Mobile</td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                    <ul class="dropdown-menu">
                        <li><button class="dropdown-item" onclick="openEditModal(@p.Id)">ویرایش</button></li>
                        <li><button class="dropdown-item text-danger" onclick="deleteItem(@p.Id)">حذف</button></li>
                    </ul>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">تعریف پرسنل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" value="0" />
                <div class="mb-3">
                    <label class="form-label">عنوان</label>
                    <input type="text" id="itemTitle" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">کد پرسنلی</label>
                    <input type="text" id="itemCode" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">شماره موبایل</label>
                    <input type="text" id="itemMobile" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">ذخیره</button>
            </div>
        </div>
    </div>
    <!-- Modal ویرایش -->
    <div class="modal fade" id="itemModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTitle">تعریف پرسنل</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="itemId" value="0" />
                    <div class="mb-3"><label class="form-label">عنوان</label><input type="text" id="itemTitle" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">کد پرسنلی</label><input type="text" id="itemCode" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label">شماره موبایل</label><input type="text" id="itemMobile" class="form-control" /></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-primary" onclick="saveItem()">ذخیره</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts
{


    <script>
        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#PersonnelTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });
        var modal = new bootstrap.Modal(document.getElementById('itemModal'));
        // var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        // let deleteId = 0;

        function openCreateModal() {
            document.getElementById('modalTitle').innerText = 'تعریف پرسنل جدید';
            document.getElementById('itemId').value = 0;
            document.getElementById('itemTitle').value = '';
            document.getElementById('itemCode').value = '';
            document.getElementById('itemMobile').value = '';
            modal.show();
        }

        function openEditModal(id) {
            $.get('/Personnel/GetById?id=' + id, function (data) {
                document.getElementById('modalTitle').innerText = 'ویرایش پرسنل';
                document.getElementById('itemId').value = data.id;
                document.getElementById('itemTitle').value = data.title;
                document.getElementById('itemCode').value = data.code;
                document.getElementById('itemMobile').value = data.mobile;
                modal.show();
            });
        }

        function saveItem() {
             if (!validateForm([
                 {id: 'itemTitle', message: 'عنوان اجباری است'},
                 {id: 'itemCode', message: 'کد اجباری است'}
             ])) return;
             if (!validatePhone('itemMobile')) return;
            var id = parseInt(document.getElementById('itemId').value);
            var data = {
                id: id,
                title: document.getElementById('itemTitle').value,
                code: document.getElementById('itemCode').value,
                mobile: document.getElementById('itemMobile').value
            };
            var url = id === 0 ? '/Personnel/CreateAjax' : '/Personnel/EditAjax';
            $.ajax({ url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {             
                        $("#itemModal").modal("hide");
                         window.location.reload()
                        // $('.ajax-link[href="/Personnel/Index"]').click();
                    }
                    else alert(result.message);
                }
            });
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Personnel/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }
        $(document).ready(function () {
                
        })
    </script>
}
