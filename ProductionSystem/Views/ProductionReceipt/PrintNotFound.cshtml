@{
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>یافت نشد</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Tahoma, sans-serif;
            background: #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        .box {
            background: white;
            border-radius: 16px;
            padding: 50px 40px;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            max-width: 400px;
        }
        .icon { font-size: 60px; margin-bottom: 20px; }
        h2 { color: #e74c3c; margin-bottom: 12px; font-size: 20px; }
        p { color: #666; margin-bottom: 30px; font-size: 14px; line-height: 1.8; }
        a {
            display: inline-block;
            background: #1470b8;
            color: white;
            padding: 12px 28px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 15px;
        }
        a:hover { background: #0f5a96; }
    </style>
</head>
<body>
<div class="box">
    <div class="icon">⚠️</div>
    <h2>لیبل یافت نشد</h2>
    <p>رسید مورد نظر وجود ندارد یا حذف شده است.</p>
    <a href="/ProductionReceipt/Index">بازگشت به لیست رسیدها</a>
</div>
</body>
</html>