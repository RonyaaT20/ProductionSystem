@using ProductionSystem.Application.IServices
@using ProductionSystem.Application.Security
@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<ProductionSystem.Domain.DTOs.ProductionReceiptDto>
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "رسید تولید";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("تولید", "#"),
        ("رسید تولید", "/ProductionReceipt/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست رسیدهای تولید</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس سفارش ، کالا ، پارامتر، یا مقدار..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateProductionReceipt.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">+ ثبت رسید تولید</button>

    }
</div>

<table class="table table-bordered table-hover" id="ProductionReceiptTable">
    <thead>
    <tr>
        <th>ردیف</th>
        <th>سفارش</th>
        <th>کالا</th>
        <th>پارامتر</th>
        <th>مقدار</th>
        @* <th>بارکد</th> *@
        <th>تاریخ</th>
        <th>عملیات</th>
    </tr>
    </thead>
    <tbody>
    @{
        int row = 1;
    }
    @foreach (var r in Model)
    {
        <tr>
            <td>@(row++)</td>
            <td>@r.OrderTitle</td>
            <td>@r.ProductTitle</td>
            <td>@(r.Parameters != null ? string.Join(", ", r.Parameters.Select(x => x.ParameterTitle).Distinct()) : "-")</td>
            <td>@r.Quantity</td>
            @* <td>@r.Barcode</td> *@
            <td>@r.CreatedAt</td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                    <ul class="dropdown-menu">

                        <li><a class="dropdown-item" href="#" onclick="printReceipt(@r.Id)">چاپ</a></li>
                        @if (PermissionService.CheckPermission(RoleChecker.DeleteProductionReceipt.ToValue(), User.GetUserId()))
                        {
                            <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@r.Id)">حذف</a></li>

                        }
                    </ul>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>

<!-- Modal ثبت -->
<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ثبت رسید تولید</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label">سفارش (اختیاری)</label>
                            <select id="itemOrderId" class="form-select" onchange="loadOrderInfo(this.value)">
                                <option value="">بدون سفارش</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">کالا</label>
                            <input type="hidden" id="itemProductId" />
                            <select id="itemProductSelect" class="form-select" onchange="loadProductParams(this.value)">
                                <option value="">انتخاب کنید</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">مقدار</label>
                            <input type="number" id="itemQuantity" step="0.001" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">پرسنل</label>
                            <select id="itemPersonnelSelect" class="form-select" onchange="addPersonnel(this)">
                                <option value="">انتخاب پرسنل</option>
                            </select>
                            <div id="selectedPersonnels" class="mt-2 d-flex flex-wrap gap-1"></div>
                            <input type="hidden" id="itemPersonnelIds" value="[]" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div id="parametersContainer">
                            <label class="form-label">پارامترها</label>
                            <div id="parametersList"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">ثبت و چاپ</button>
            </div>
        </div>
    </div>
</div>
@section Scripts
{
    <style>
        .is-invalid {
            border: 2px solid red !important;
        }

        .invalid-feedback {
            color: red;
            font-size: 12px;
            margin-top: 5px;
        }

        .field-required::after {
            content: " *";
            color: red;
            font-weight: bold;
        }
    </style>

    <script>
        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#ProductionReceiptTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });

        var modal;
        var selectedPersonnelList = [];
        var selectedParameters = {};

        $(document).ready(function () {
            modal = new bootstrap.Modal(document.getElementById('itemModal'));
        });

        // ========== توابع اعتبارسنجی ==========
        function validateForm(fields) {
            let isValid = true;

            for (let field of fields) {
                let element = document.getElementById(field.id);
                let value = element ? element.value.trim() : '';

                if (value === '' || value === '0' || value === 'false' || value === 0) {
                    // قرمز کردن فیلد خطا
                    element.classList.add('is-invalid');

                    // اضافه کردن پیام خطا در زیر فیلد اگر وجود نداشت
                    let errorDiv = element.nextElementSibling;
                    if (!errorDiv || !errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv = document.createElement('div');
                        errorDiv.className = 'invalid-feedback';
                        errorDiv.innerText = field.message;
                        element.parentNode.insertBefore(errorDiv, element.nextSibling);
                    }

                    isValid = false;
                } else {
                    // پاک کردن حالت خطا اگر فیلد درست شده
                    element.classList.remove('is-invalid');
                    let errorDiv = element.nextElementSibling;
                    if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv.remove();
                    }
                }
            }

            return isValid;
        }

        function addValidationEvents(fields) {
            for (let field of fields) {
                let element = document.getElementById(field.id);
                if (element) {
                    element.addEventListener('input', function() {
                        if (this.value.trim() !== '' && this.value !== '0' && this.value !== 'false') {
                            this.classList.remove('is-invalid');
                            let errorDiv = this.nextElementSibling;
                            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                                errorDiv.remove();
                            }
                        }
                    });

                    element.addEventListener('change', function() {
                        if (this.value !== '' && this.value !== '0') {
                            this.classList.remove('is-invalid');
                            let errorDiv = this.nextElementSibling;
                            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                                errorDiv.remove();
                            }
                        }
                    });
                }
            }
        }

        function validateParameters() {
            let isValid = true;

            for (let [parameterId, value] of Object.entries(selectedParameters)) {
                let element = document.getElementById('param_' + parameterId);
                if (element && (value === null || value === '' || value === 0)) {
                    element.classList.add('is-invalid');

                    let errorDiv = element.nextElementSibling;
                    if (!errorDiv || !errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv = document.createElement('div');
                        errorDiv.className = 'invalid-feedback';
                        errorDiv.innerText = 'لطفاً مقدار پارامتر را وارد کنید';
                        element.parentNode.insertBefore(errorDiv, element.nextSibling);
                    }

                    isValid = false;
                } else if (element) {
                    element.classList.remove('is-invalid');
                    let errorDiv = element.nextElementSibling;
                    if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv.remove();
                    }
                }
            }

            return isValid;
        }
        // ====================================

        function openCreateModal() {
            selectedPersonnelList = [];
            selectedParameters = {};
            document.getElementById('itemQuantity').value = '';
            document.getElementById('selectedPersonnels').innerHTML = '';
            document.getElementById('parametersList').innerHTML = '';
            document.getElementById('itemPersonnelIds').value = '[]';

            // پاک کردن خطاها
            document.getElementById('itemProductSelect').classList.remove('is-invalid');
            document.getElementById('itemQuantity').classList.remove('is-invalid');

            loadOrders();
            loadProducts();
            loadPersonnels();
            modal.show();
        }

        function loadOrders() {
            $.get('/Order/GetAllJson', function (data) {
                var sel = document.getElementById('itemOrderId');
                sel.innerHTML = '<option value="">بدون سفارش</option>';
                data.forEach(function (o) {
                    var opt = document.createElement('option');
                    opt.value = o.id; opt.text = o.title;
                    sel.appendChild(opt);
                });
            });
        }

        function loadProducts(selectedId, disableSelect) {
            $.get('/Product/GetAllJson', function (data) {
                var sel = document.getElementById('itemProductSelect');
                sel.innerHTML = '<option value="">انتخاب کنید</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.id; opt.text = p.title;
                    if (selectedId && p.id == selectedId) opt.selected = true;
                    sel.appendChild(opt);
                });

                // قفل یا آزاد کردن select کالا
                sel.disabled = disableSelect === true;

                if (selectedId && !disableSelect) loadProductParams(selectedId);
            });
        }

        function loadPersonnels() {
            $.get('/Personnel/GetAllJson', function (data) {
                var sel = document.getElementById('itemPersonnelSelect');
                sel.innerHTML = '<option value="">انتخاب پرسنل</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.id; opt.text = p.title;
                    sel.appendChild(opt);
                });
            });
        }

        function addPersonnel(sel) {
            var id = parseInt(sel.value);
            var title = sel.options[sel.selectedIndex].text;
            if (!id) return;
            if (selectedPersonnelList.find(p => p.id == id)) return;

            selectedPersonnelList.push({ id: id, title: title });
            renderPersonnels();
            sel.value = '';
        }

        function removePersonnel(id) {
            selectedPersonnelList = selectedPersonnelList.filter(p => p.id != id);
            renderPersonnels();
        }

        function renderPersonnels() {
            var container = document.getElementById('selectedPersonnels');
            container.innerHTML = '';
            selectedPersonnelList.forEach(function (p) {
                var span = document.createElement('span');
                span.className = 'badge bg-primary d-flex align-items-center gap-1 p-2';
                span.innerHTML = p.title + ' <span style="cursor:pointer" onclick="removePersonnel(' + p.id + ')">×</span>';
                container.appendChild(span);
            });
            document.getElementById('itemPersonnelIds').value = JSON.stringify(selectedPersonnelList.map(p => p.id));
        }

        function loadOrderInfo(orderId) {
            if (!orderId) {
                // وقتی سفارش پاک شد، کالا رو آزاد کن
                var productSelect = document.getElementById('itemProductSelect');
                productSelect.disabled = false;
                loadProducts(null);
                document.getElementById('parametersList').innerHTML = '';
                return;
            }

            $.get('/ProductionReceipt/GetProductByOrder?orderId=' + orderId, function (data) {
                if (data) {
                    // لود کالا و قفل کردنش
                    loadProducts(data.productId, true); // true = disable
                    document.getElementById('itemProductId').value = data.productId;

                    // رندر پارامترها از داده سفارش (نه درخواست جداگانه)
                    if (data.parameters) {
                        renderParameters(data.parameters.map(function(p) {
                            return {
                                parameterId: p.parameterId,
                                parameterTitle: p.parameterTitle,
                                values: p.values || []
                            };
                        }));
                    }
                }
            });
        }


        function loadProductParams(productId) {
            if (!productId) {
                document.getElementById('parametersList').innerHTML = '';
                return;
            }
            document.getElementById('itemProductId').value = productId;
            $.get('/Product/GetById?id=' + productId, function (data) {
                if (data && data.parameters) {
                    var params = data.parameters.map(function(p) {
                        return {
                            parameterId: p.parameterId,
                            parameterTitle: p.parameterTitle,
                            values: []
                        };
                    });
                    var loaded = 0;
                    if (params.length === 0) {
                        renderParameters([]);
                        return;
                    }
                    params.forEach(function(p, i) {
                        $.get('/Parameter/GetValues?parameterId=' + p.parameterId, function(values) {
                            params[i].values = values;
                            loaded++;
                            if (loaded === params.length) renderParameters(params);
                        });
                    });
                }
            });
        }

        function renderParameters(params) {
            selectedParameters = {};
            var container = document.getElementById('parametersList');
            container.innerHTML = '';

            if (params.length === 0) {
                container.innerHTML = '<div class="alert alert-info">این کالا هیچ پارامتری ندارد</div>';
                return;
            }

            params.forEach(function (p) {
                selectedParameters[p.parameterId] = null;

                var div = document.createElement('div');
                div.className = 'mb-3';

                var label = document.createElement('label');
                label.className = 'form-label fw-bold field-required';
                label.innerText = p.parameterTitle;
                div.appendChild(label);

                if (p.values && p.values.length > 0) {
                    var select = document.createElement('select');
                    select.className = 'form-select';
                    select.id = 'param_' + p.parameterId;
                    select.innerHTML = '<option value="">انتخاب مقدار</option>';
                    p.values.forEach(function (v) {
                        var opt = document.createElement('option');
                        opt.value = v.id; opt.text = v.title;
                        select.appendChild(opt);
                    });
                    select.onchange = function() {
                        selectedParameters[p.parameterId] = this.value ? parseInt(this.value) : null;
                        this.classList.remove('is-invalid');
                        let errorDiv = this.nextElementSibling;
                        if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                            errorDiv.remove();
                        }
                    };
                    div.appendChild(select);
                } else {
                    var input = document.createElement('input');
                    input.type = 'text';
                    input.className = 'form-control';
                    input.placeholder = 'مقدار وارد کنید';
                    input.id = 'param_' + p.parameterId;
                    input.onchange = function() {
                        selectedParameters[p.parameterId] = this.value.trim() || null;
                        this.classList.remove('is-invalid');
                        let errorDiv = this.nextElementSibling;
                        if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                            errorDiv.remove();
                        }
                    };
                    input.oninput = function() {
                        if (this.value.trim() !== '') {
                            this.classList.remove('is-invalid');
                            let errorDiv = this.nextElementSibling;
                            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                                errorDiv.remove();
                            }
                        }
                    };
                    div.appendChild(input);
                }

                container.appendChild(div);
            });
        }

        // ========== تابع saveItem اصلاح شده با اعتبارسنجی ==========
        function saveItem() {
            var productId = parseInt(document.getElementById('itemProductId').value) ||
                            parseInt(document.getElementById('itemProductSelect').value);

            var quantity = parseFloat(document.getElementById('itemQuantity').value);

            // تعریف فیلدهای اجباری
            var fields = [
                {id: 'itemProductSelect', message: 'لطفاً کالا را انتخاب کنید'},
                {id: 'itemQuantity', message: 'لطفاً مقدار را وارد کنید'}
            ];

            // اضافه کردن event listenerها برای حذف خطا هنگام تایپ
            if (window.validationEventsAdded !== true) {
                addValidationEvents(fields);
                window.validationEventsAdded = true;
            }

            // اعتبارسنجی فیلدهای اجباری
            if (!validateForm(fields)) return;

            // اعتبارسنجی مقدار (باید بزرگتر از 0 باشد)
            if (quantity <= 0) {
                var qtyElement = document.getElementById('itemQuantity');
                qtyElement.classList.add('is-invalid');
                let errorDiv = qtyElement.nextElementSibling;
                if (!errorDiv || !errorDiv.classList.contains('invalid-feedback')) {
                    errorDiv = document.createElement('div');
                    errorDiv.className = 'invalid-feedback';
                    errorDiv.innerText = 'مقدار باید بزرگتر از صفر باشد';
                    qtyElement.parentNode.insertBefore(errorDiv, qtyElement.nextSibling);
                }
                return;
            }

            // اعتبارسنجی پارامترها
            if (!validateParameters()) return;

            var personnelIds = JSON.parse(document.getElementById('itemPersonnelIds').value || '[]');

            var parameterValues = Object.entries(selectedParameters).map(function([key, val]) {
                if (val !== null && val !== '') {
                    return { parameterId: parseInt(key), valueId: val };
                }
                return null;
            }).filter(function(item) {
                return item !== null;
            });

            var data = {
                orderId: parseInt(document.getElementById('itemOrderId').value) || null,
                productId: productId,
                quantity: quantity,
                personnelIds: personnelIds,
                parameterValues: parameterValues
            };

            // غیرفعال کردن دکمه ذخیره
            var saveBtn = document.querySelector('#itemModal .btn-primary');
            var originalText = saveBtn.innerText;
            saveBtn.disabled = true;
            saveBtn.innerText = 'در حال ثبت...';

            $.ajax({
                url: '/ProductionReceipt/CreateAjax',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        modal.hide();
                        if (result.receiptId) window.open('/ProductionReceipt/Print?id=' + result.receiptId, '_blank');
                        location.reload();
                    } else {
                        alert(result.message || 'خطا در ثبت رسید');
                    }
                },
                error: function (xhr, status, error) {
                    alert('خطایی رخ داده است: ' + error);
                },
                complete: function() {
                    saveBtn.disabled = false;
                    saveBtn.innerText = originalText;
                }
            });
        }
        // =====================================================

        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/ProductionReceipt/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }
        function printReceipt(id) {
            window.open('/ProductionReceipt/Print?id=' + id, '_blank');
        }
    </script>
}