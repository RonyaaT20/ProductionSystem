@using ProductionSystem.Application.IServices
@using ProductionSystem.Application.Security
@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<ProductionSystem.Domain.DTOs.UserDto>
@inject IPermissionService PermissionService


@{
    ViewData["Title"] = "کاربران";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("اطلاعات پایه", "#"),
        ("کاربر", "/User/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست کاربران</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس نام کامل ، نام کاربری ، موبایل ، نقش ، وضعیت یا تاریخ ایجاد..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateUser.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">+ تعریف کاربر</button>

    }

</div>

<table class="table table-bordered table-hover" id="UserTable">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>نام کامل</th>
            <th>نام کاربری</th>
            <th>موبایل</th>
            <th>نقش</th>
            <th>وضعیت</th>
            <th>تاریخ ایجاد</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @{
            int row = 1;
        }

        @foreach (var u in Model)
        {
            <tr>
                <td>@(row++)</td>
                <td>@u.FullName</td>
                <td>@u.Username</td>
                <td>@u.Mobile</td>
                <td>@u.RoleTitle</td>
                <td>@(u.IsActive ? "فعال" : "غیرفعال")</td>
                <td>@u.CreatedAt</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                        <ul class="dropdown-menu">
                            @if (PermissionService.CheckPermission(RoleChecker.EditCustomer.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item" href="#" onclick="openEditModal(@u.Id)">ویرایش</a></li>
                            }
                            @if (PermissionService.CheckPermission(RoleChecker.DeleteCustomer.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@u.Id)">حذف</a></li>

                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">تعریف کاربر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" value="0" />
                <div class="mb-3"><label class="form-label">نام کامل</label><input type="text" id="itemFullName" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">نام کاربری</label><input type="text" id="itemUsername" class="form-control" /><div id="usernameFeedback" class="small mt-1"></div></div>
                <div class="mb-3"><label class="form-label">رمز عبور</label><input type="password" id="itemPassword" class="form-control" /><small class="text-muted">در ویرایش خالی بگذارید تا تغییر نکند</small></div>
                <div class="mb-3"><label class="form-label">موبایل</label><input type="text" id="itemMobile" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">نقش</label><select id="itemRoleId" class="form-select" data-url="/User/GetRoles"></select></div>
                <div class="mb-3"><label class="form-label">وضعیت</label><select id="itemIsActive" class="form-select"><option value="true">فعال</option><option value="false">غیرفعال</option></select></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">ذخیره</button>
            </div>
        </div>
    </div>

</div>


@section Scripts
{

    <script>
                        const searchInput = document.getElementById("searchInput");
                const rows = document.querySelectorAll("#UserTable tbody tr");

                searchInput.addEventListener("keyup", function () {
                    const value = this.value.toLowerCase();

                    rows.forEach(row => {
                        const rowText = row.innerText.toLowerCase();

                        if (rowText.includes(value)) {
                            row.style.display = "";
                        } else {
                            row.style.display = "none";
                        }
                    });
                });
                const modal = new bootstrap.Modal(document.getElementById('itemModal'));
                // const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
                // let deleteId = 0;

                function loadRoles(selectedId) {
                    $.get('/User/GetRoles', function (data) {
                        var sel = document.getElementById('itemRoleId');
                        sel.innerHTML = '<option value="">انتخاب کنید</option>';
                        data.forEach(function (r) {
                            var opt = document.createElement('option');
                            opt.value = r.id; opt.text = r.title;
                            if (selectedId && r.id == selectedId) opt.selected = true;
                            sel.appendChild(opt);
                        });
                    });
                }

                function openCreateModal() {
                    document.getElementById('modalTitle').innerText = 'تعریف کاربر جدید';
                    document.getElementById('itemId').value = 0;
                    document.getElementById('itemFullName').value = '';
                    document.getElementById('itemUsername').value = '';
                    document.getElementById('itemPassword').value = '';
                    document.getElementById('itemMobile').value = '';
                    document.getElementById('itemIsActive').value = 'true';
                    loadRoles(null);
                    $("#itemModal").modal("show");
                }

                function openEditModal(id) {
                    $.get('/User/GetById?id=' + id, function (data) {
                        document.getElementById('modalTitle').innerText = 'ویرایش کاربر';
                        document.getElementById('itemId').value = data.id;
                        document.getElementById('itemFullName').value = data.fullName;
                        document.getElementById('itemUsername').value = data.username;
                        document.getElementById('itemPassword').value = '';
                        document.getElementById('itemMobile').value = data.mobile;
                        document.getElementById('itemIsActive').value = data.isActive.toString();
                        loadRoles(data.roleId);
                        $("#itemModal").modal("show");
                    });
                }

                        // تبدیل لیست کاربران به آرایه جاوااسکریپت
        var usersList = @Html.Raw(Json.Serialize(Model));

        // تابع بررسی تکراری بودن نام کاربری
        function isUsernameDuplicate(username, userId) {
            return usersList.some(u => u.username === username && u.id !== userId);
        }

        // تغییر تابع saveItem
        function saveItem() {
            var id = parseInt(document.getElementById('itemId').value);
            var username = document.getElementById('itemUsername').value;

            // اعتبارسنجی فیلدهای اجباری
            var fields = [
                {id: 'itemFullName', message: 'نام کامل اجباری است'},
                {id: 'itemUsername', message: 'نام کاربری اجباری است'},
                {id: 'itemRoleId', message: 'نقش اجباری است'}
            ];

            if (id === 0) fields.push({id: 'itemPassword', message: 'رمز عبور اجباری است'});
            if (!validateForm(fields)) return;
            if (!validatePhone('itemMobile')) return;

            // بررسی تکراری بودن نام کاربری
            if (isUsernameDuplicate(username, id)) {
                Swal.fire({
                    title: 'خطا!',
                    text: 'این نام کاربری قبلاً ثبت شده است. لطفاً نام کاربری دیگری انتخاب کنید.',
                    icon: 'error',
                    confirmButtonText: 'متوجه شدم'
                });
                return; // جلوگیری از ذخیره
            }

            // ادامه کد قبلی saveItem
            var data = {
                id: id,
                fullName: document.getElementById('itemFullName').value,
                username: username,
                password: document.getElementById('itemPassword').value,
                mobile: document.getElementById('itemMobile').value,
                roleId: parseInt(document.getElementById('itemRoleId').value),
                isActive: document.getElementById('itemIsActive').value === 'true'
            };

            var url = id === 0 ? '/User/CreateAjax' : '/User/EditAjax';
            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        $("#itemModal").modal("hide");
                        Swal.fire('موفق!', 'عملیات با موفقیت انجام شد.', 'success')
                            .then(() => window.location.reload());
                    } else {
                        Swal.fire('خطا!', result.message, 'error');
                    }
                },
                error: function(xhr) {
                    Swal.fire('خطا!', 'مشکلی در ذخیره سازی رخ داده است.', 'error');
                }
            });
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/User/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }



    </script>
}
