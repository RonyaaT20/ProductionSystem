@section Scripts
{
    <style>
        .is-invalid {
            border: 2px solid red !important;
        }

        .invalid-feedback {
            color: red;
            font-size: 12px;
            margin-top: 5px;
        }
    </style>

    <script>
        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#RoleTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });

        var modal;

        $(document).ready(function () {
            modal = new bootstrap.Modal(document.getElementById('itemModal'));
        });

        // ========== توابع اعتبارسنجی ==========
        function validateForm(fields) {
            let isValid = true;

            for (let field of fields) {
                let element = document.getElementById(field.id);
                let value = element ? element.value.trim() : '';

                if (value === '' || value === '0' || value === 'false') {
                    // قرمز کردن فیلد خطا
                    element.classList.add('is-invalid');

                    // اضافه کردن پیام خطا در زیر فیلد اگر وجود نداشت
                    let errorDiv = element.nextElementSibling;
                    if (!errorDiv || !errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv = document.createElement('div');
                        errorDiv.className = 'invalid-feedback';
                        errorDiv.innerText = field.message;
                        element.parentNode.insertBefore(errorDiv, element.nextSibling);
                    }

                    isValid = false;
                } else {
                    // پاک کردن حالت خطا اگر فیلد درست شده
                    element.classList.remove('is-invalid');
                    let errorDiv = element.nextElementSibling;
                    if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                        errorDiv.remove();
                    }
                }
            }

            return isValid;
        }

        function addValidationEvents(fields) {
            for (let field of fields) {
                let element = document.getElementById(field.id);
                if (element) {
                    element.addEventListener('input', function() {
                        if (this.value.trim() !== '' && this.value !== '0' && this.value !== 'false') {
                            this.classList.remove('is-invalid');
                            let errorDiv = this.nextElementSibling;
                            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                                errorDiv.remove();
                            }
                        }
                    });

                    element.addEventListener('change', function() {
                        if (this.value !== '' && this.value !== '0') {
                            this.classList.remove('is-invalid');
                            let errorDiv = this.nextElementSibling;
                            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                                errorDiv.remove();
                            }
                        }
                    });
                }
            }
        }
        // ====================================

        function toggleAll(checkbox) {
            var checked = checkbox.checked;
            document.querySelectorAll('.perm-check, .crud-check').forEach(c => c.checked = checked);
            if (checked) {
                document.querySelectorAll('[id^="crud_"]').forEach(function(div) {
                    if (div.tagName === 'DIV') div.style.display = 'block';
                });
            }
        }

        function toggleCrud(section, btn) {
            var div = document.getElementById('crud_' + section);
            if (div.style.display === 'none') {
                div.style.display = 'block';
                btn.innerText = '-';
            } else {
                div.style.display = 'none';
                btn.innerText = '+';
            }
        }

        function onMainPermChange(section, checkbox) {
            if (checkbox.checked) {
                document.querySelectorAll('[data-parent="' + section + '"]').forEach(c => c.checked = true);
                document.getElementById('crud_' + section).style.display = 'block';
                var btn = document.querySelector('[onclick="toggleCrud(\'' + section + '\', this)"]');
                if (btn) btn.innerText = '-';
            } else {
                document.querySelectorAll('[data-parent="' + section + '"]').forEach(c => c.checked = false);
            }
            var allChecked = document.querySelectorAll('.perm-check:not(:checked)').length === 0;
            document.getElementById('perm_all').checked = allChecked;
        }

        function openCreateModal() {
            document.getElementById('modalTitle').innerText = 'تعریف نقش جدید';
            document.getElementById('itemId').value = 0;
            document.getElementById('itemTitle').value = '';

            // پاک کردن خطا
            document.getElementById('itemTitle').classList.remove('is-invalid');
            let errorDiv = document.getElementById('itemTitle').nextElementSibling;
            if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                errorDiv.remove();
            }

            document.querySelectorAll('.perm-check, .crud-check').forEach(c => c.checked = false);
            document.getElementById('perm_all').checked = false;
            modal.show();
        }

        function openEditModal(id) {
            $.get('/Role/GetById?id=' + id, function (data) {
                document.getElementById('modalTitle').innerText = 'ویرایش نقش';
                document.getElementById('itemId').value = data.id;
                document.getElementById('itemTitle').value = data.title;

                // پاک کردن خطا
                document.getElementById('itemTitle').classList.remove('is-invalid');
                let errorDiv = document.getElementById('itemTitle').nextElementSibling;
                if (errorDiv && errorDiv.classList.contains('invalid-feedback')) {
                    errorDiv.remove();
                }

                document.querySelectorAll('.perm-check, .crud-check').forEach(c => c.checked = false);

                if (data.permissions) {
                    data.permissions.forEach(function (p) {
                        var el = document.getElementById('perm_' + p) ||
                                 document.querySelector('input[value="' + p + '"]');
                        if (el) el.checked = true;
                    });
                }

                document.querySelectorAll('.perm-check:checked').forEach(function(c) {
                    var crudDiv = document.getElementById('crud_' + c.value);
                    if (crudDiv) {
                        crudDiv.style.display = 'block';
                        var btn = document.querySelector('[onclick="toggleCrud(\'' + c.value + '\', this)"]');
                        if (btn) btn.innerText = '-';
                    }
                });

                var allChecked = document.querySelectorAll('.perm-check').length ===
                                 document.querySelectorAll('.perm-check:checked').length;
                document.getElementById('perm_all').checked = allChecked;

                modal.show();
            });
        }

        // ========== تابع saveItem اصلاح شده با اعتبارسنجی ==========
        function saveItem() {
            var id = parseInt(document.getElementById('itemId').value);

            // تعریف فیلدهای اجباری
            var fields = [
                {id: 'itemTitle', message: 'عنوان نقش اجباری است'}
            ];

            // اضافه کردن event listenerها برای حذف خطا هنگام تایپ (یکبار کافیست)
            if (window.validationEventsAdded !== true) {
                addValidationEvents(fields);
                window.validationEventsAdded = true;
            }

            // اعتبارسنجی فیلدهای اجباری
            if (!validateForm(fields)) return;

            var perms = [];
            document.querySelectorAll('.perm-check:checked, .crud-check:checked').forEach(c => perms.push(c.value));

            var data = {
                id: id,
                title: document.getElementById('itemTitle').value,
                permissions: perms
            };

            var url = id === 0 ? '/Role/CreateAjax' : '/Role/EditAjax';

            // غیرفعال کردن دکمه ذخیره
            var saveBtn = document.querySelector('#itemModal .btn-primary');
            var originalText = saveBtn.innerText;
            saveBtn.disabled = true;
            saveBtn.innerText = 'در حال ذخیره...';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        modal.hide();
                        location.reload();
                    }
                    else alert(result.message);
                },
                error: function (xhr, status, error) {
                    alert('خطایی رخ داده است: ' + error);
                },
                complete: function() {
                    saveBtn.disabled = false;
                    saveBtn.innerText = originalText;
                }
            });
        }
        // =====================================================

                function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Role/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }

                function toggleParamValues(checkbox) {
            var sub = document.getElementById('crud_Parameter_values_sub');
            sub.style.display = checkbox.checked ? 'block' : 'none';
        }

    </script>
}