@using ProductionSystem.Application.IServices
@using ProductionSystem.Application.Security
@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@model List<ProductionSystem.Domain.DTOs.RoleDto>
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "سطح دسترسی";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("اطلاعات پایه", "#"),
        ("سطح دسترسی", "/Role/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست سطح دسترسی</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس عنوان ، یا تاریخ ایجاد..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateRole.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">+ تعریف نقش</button>

    }

</div>

<table class="table table-bordered table-hover" id="RoleTable">
    <thead>
    <tr>
        <th>ردیف</th>
        <th>عنوان</th>
        <th>تاریخ ایجاد</th>
        <th>عملیات</th>
    </tr>
    </thead>
    <tbody>
    @{
        int row = 1;
    }
    @foreach (var r in Model)
    {
        <tr>
            <td>@(row++)</td>
            <td>@r.Title</td>
            <td>@r.CreatedAt</td>
            <td>
                <div class="dropdown">
                    <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                    <ul class="dropdown-menu">
                        @if (PermissionService.CheckPermission(RoleChecker.EditRole.ToValue(), User.GetUserId()))
                        {
                            <li><a class="dropdown-item" href="#" onclick="openEditModal(@r.Id)">ویرایش</a></li>
                        }
                        @if (PermissionService.CheckPermission(RoleChecker.DeleteRole.ToValue(), User.GetUserId()))
                        {
                            <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@r.Id)">حذف</a></li>

                        }
                    </ul>
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
