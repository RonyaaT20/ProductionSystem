        function exportExcel() {
            var productId = document.getElementById('filterProduct').value;
            var parameterId = document.getElementById('filterParameter').value;
            var fromDate = document.getElementById('filterFrom').value;
            var toDate = document.getElementById('filterTo').value;
            window.location.href = '/Report/ExportExcel?productId=' + productId + '&parameterId=' + parameterId + '&fromDate=' + fromDate + '&toDate=' + toDate;
        }

        function exportPdf() {
