@{
    ViewData["Title"] = "گزارش تولید";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("تولید", "#"),
        ("گزارش تولید", "/Report/Production")
    };
}

<style>
    @@media print {
        body *

    {
        visibility: hidden;
    }

    #report-table, #report-table * {
        visibility: visible;
    }

    #report-table {
        position: absolute;
        top: 0;
        right: 0;
        width: 100%;
    }

    }

    .btn:not(.btn-outline):not(.btn-dashed):not(.border-hover):not(.border-active):not(.btn-flush):not(.btn-icon){
        padding: 0px 30px;
    }
    
</style>

<h4 class="mb-4">گزارش تولید</h4>
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">کالا</label>
                <select id="filterProduct" class="form-select">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">پارامتر</label>
                <select id="filterParameter" class="form-select">
                    <option value="">همه</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">از تاریخ</label>
                <input type="text" id="filterFrom" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">تا تاریخ</label>
                <input type="text" id="filterTo" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary w-100" onclick="loadReport()">فیلتر</button>
                <button class="btn btn-outline-secondary" onclick="clearFilter()">حذف فیلتر</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-outline-secondary" onclick="window.print()">🖨 چاپ</button>
    <button class="btn btn-outline-success" onclick="exportExcel()">📊 اکسل</button>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس سفارش ، کالا ، کد کالا ، پارامتر یا مقدار..." style="  width: 988px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 0px; outline: none; margin-left: 0px; text-align: center; color: #1470b8; margin-top:0px; background-color:transparent; height:45px;">
</div>

<div id="noDataMsg" class="alert alert-info d-none">رسیدی با این مشخصات پیدا نشد.</div>

<table class="table table-bordered" id="report-table">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>سفارش</th>
            <th>کالا</th>
            <th>کد کالا</th>
            <th>پارامتر</th>
            <th>مقدار</th>
            <th>تاریخ</th>
        </tr>
    </thead>
    <tbody id="report-body">
    </tbody>
</table>

@section Scripts
{
    <script>
        const searchInput = document.getElementById("searchInput");

        function applySearchFilter() {
            const value = searchInput.value.toLowerCase().trim();
            const rows = document.querySelectorAll("#report-table tbody tr");
            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();
                row.style.display = rowText.includes(value) ? "" : "none";
            });
        }

        searchInput.addEventListener("keyup", applySearchFilter);

        // بارگذاری لیست کالا و پارامتر
        $.get('/Product/GetAllJson', function (data) {
            const sel = document.getElementById('filterProduct');
            data.forEach(p => {
                const opt = new Option(p.title, p.id);
                sel.appendChild(opt);
            });
        });

        $.get('/Parameter/GetAllJson', function (data) {
            const sel = document.getElementById('filterParameter');
            data.forEach(p => {
                const opt = new Option(p.title, p.id);
                sel.appendChild(opt);
            });
        });

        function loadReport() {
            const params = {
                productId: document.getElementById('filterProduct').value,
                parameterId: document.getElementById('filterParameter').value,
                fromDate: document.getElementById('filterFrom').value,
                toDate: document.getElementById('filterTo').value
            };

            $.get('/Report/GetData', params, function (data) {
                const tbody = document.getElementById('report-body');
                const noData = document.getElementById('noDataMsg');

                tbody.innerHTML = '';

                if (data.length === 0) {
                    noData.classList.remove('d-none');
                } else {
                    noData.classList.add('d-none');
                    data.forEach((r, i) => {
                        const row = `
                            <tr>
                                <td>${i + 1}</td>
                                <td>${r.orderTitle || '-'}</td>
                                <td>${r.productTitle || '-'}</td>
                                <td>${r.productCode || '-'}</td>
                                <td>${r.parameterTitle || '-'}${r.parameterValue ? ' : ' + r.parameterValue : ''}</td>
                                <td>${r.quantity}</td>
                                <td>${r.createdAt}</td>
                            </tr>`;
                        tbody.innerHTML += row;
                    });
                }
                applySearchFilter();
            });
        }

        function clearFilter() {
            document.getElementById('filterProduct').value = '';
            document.getElementById('filterParameter').value = '';
            document.getElementById('filterFrom').value = '';
            document.getElementById('filterTo').value = '';
            loadReport();
        }

        // تابع اکسل (اصلاح شده)
        function exportExcel() {
            const productId = document.getElementById('filterProduct').value || '';
            const parameterId = document.getElementById('filterParameter').value || '';
            const fromDate = document.getElementById('filterFrom').value || '';
            const toDate = document.getElementById('filterTo').value || '';

            let url = `/Report/ExportExcel?productId=${encodeURIComponent(productId)}&parameterId=${encodeURIComponent(parameterId)}`;

            if (fromDate) url += `&fromDate=${encodeURIComponent(fromDate)}`;
            if (toDate) url += `&toDate=${encodeURIComponent(toDate)}`;

            console.log('Export Excel URL:', url); // برای دیباگ
            window.location.href = url;
        }

        // ====================== اجرای اولیه ======================
        $(document).ready(function () {
            $('#filterFrom').persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true
            });

            $('#filterTo').persianDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true
            });

            // خالی کردن فیلدهای تاریخ
            document.getElementById('filterFrom').value = '';
            document.getElementById('filterTo').value = '';

            // بارگذاری اولیه همه گزارش‌ها
            loadReport();
        });
    </script>
}