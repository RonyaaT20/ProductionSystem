    <script>
                const searchInput = document.getElementById("searchInput");

        // تابع فیلتر - هر بار ردیف‌های جاری را می‌گیرد
        function applySearchFilter() {
            const value = searchInput.value.toLowerCase();
            const currentRows = document.querySelectorAll("#report-table tbody tr");

            currentRows.forEach(row => {
                const rowText = row.innerText.toLowerCase();
                row.style.display = rowText.includes(value) ? "" : "none";
            });
        }

        // رویداد جستجو
        searchInput.addEventListener("keyup", applySearchFilter);

        // بارگذاری فیلترها
        $.get('/Product/GetAllJson', function (data) {
            var sel = document.getElementById('filterProduct');
            data.forEach(function (p) {
                var opt = document.createElement('option');
                opt.value = p.id; opt.text = p.title;
                sel.appendChild(opt);
            });
        });

        $.get('/Parameter/GetAllJson', function (data) {
            var sel = document.getElementById('filterParameter');
            data.forEach(function (p) {
                var opt = document.createElement('option');
                opt.value = p.id; opt.text = p.title;
                sel.appendChild(opt);
            });
        });

        function loadReport() {
            var params = {
                productId: document.getElementById('filterProduct').value,
                parameterId: document.getElementById('filterParameter').value,
                fromDate: document.getElementById('filterFrom').value,
                toDate: document.getElementById('filterTo').value
            };

            $.get('/Report/GetData', params, function (data) {
                var tbody = document.getElementById('report-body');
                var noData = document.getElementById('noDataMsg');
                tbody.innerHTML = '';

                if (data.length === 0) {
                    noData.classList.remove('d-none');
                    return;
                }

                noData.classList.add('d-none');

                data.forEach(function (r, i) {
                    var row = '<tr>';
                    row += '<td>' + (i + 1) + '</td>';
                    row += '<td>' + (r.orderTitle || '-') + '</td>';
                    row += '<td>' + (r.productTitle || '-') + '</td>';
                    row += '<td>' + (r.productCode || '-') + '</td>';
                    row += '<td>' + (r.parameterTitle || '-') + (r.parameterValue ? ' : ' + r.parameterValue : '') + '</td>';
                    row += '<td>' + r.quantity + '</td>';
                    row += '<td>' + r.createdAt + '</td>';
                    row += '</tr>';
                    tbody.innerHTML += row;
                });

                // 🔥 بعد از پر شدن جدول، فیلتر جستجو را دوباره اعمال کن
                applySearchFilter();
            });
        }

        function clearFilter() {
            document.getElementById('filterProduct').value = '';
            document.getElementById('filterParameter').value = '';
            document.getElementById('filterFrom').value = '';
            document.getElementById('filterTo').value = '';
            loadReport();
        }
