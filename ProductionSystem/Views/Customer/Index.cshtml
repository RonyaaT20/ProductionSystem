@using ProductionSystem.Application.IServices
@using ProductionSystem.Application.Security
@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@model List<ProductionSystem.Domain.DTOs.CustomerDto>
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "مشتریان";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("اطلاعات پایه", "#"),
        ("مشتری", "/Customer/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست مشتریان</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس عنوان ، کد ، موبایل ، استان یا شهرستان..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateCustomer.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">+ تعریف مشتری</button>
    }
</div>

<table class="table table-bordered table-hover" id="CustomerTable">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>عنوان</th>
            <th>کد</th>
            <th>موبایل</th>
            <th>استان</th>
            <th>شهرستان</th>
            <th>آدرس</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @{
            int row = 1;
        }
        @foreach (var c in Model)
        {
            <tr>
                <td>@(row++)</td>
                <td>@c.Title</td>
                <td>@c.Code</td>
                <td>@c.Mobile</td>
                <td>@c.Province</td>
                <td>@c.City</td>
                <td>@c.Address</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                        <ul class="dropdown-menu">
                            @if (PermissionService.CheckPermission(RoleChecker.EditCustomer.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item" href="#" onclick="openEditModal(@c.Id)">ویرایش</a></li>
                            }
                            @if (PermissionService.CheckPermission(RoleChecker.DeleteCustomer.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@c.Id)">حذف</a></li>

                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">تعریف مشتری</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" value="0" />
                <div class="mb-3">
                    <label class="form-label">عنوان</label>
                    <input type="text" id="itemTitle" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">کد</label>
                    <input type="text" id="itemCode" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">شماره موبایل</label>
                    <input type="text" id="itemMobile" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">استان</label>
                    <select id="itemProvince" class="form-select" onchange="loadCities(this.value)">
                        <option value="">انتخاب کنید</option>
                        <option>تهران</option>
                        <option>اصفهان</option>
                        <option>خراسان رضوی</option>
                        <option>فارس</option>
                        <option>آذربایجان شرقی</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">شهرستان</label>
                    <select id="itemCity" class="form-select">
                        <option value="">ابتدا استان را انتخاب کنید</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">آدرس</label>
                    <textarea id="itemAddress" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">ذخیره</button>
            </div>
        </div>
    </div>
    <!-- Modal حذف -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">آیا از حذف این مورد مطمئن هستید؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="button" class="btn btn-danger" id="confirmDelete">حذف</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#CustomerTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });

        var modal = new bootstrap.Modal(document.getElementById('itemModal'));

        // توابع کمکی برای اعتبارسنجی
        function showError(elementId, message) {
            const element = document.getElementById(elementId);
            const existingError = $(element).next('.text-danger');
            if (existingError.length) existingError.remove();

            const errorSpan = $('<span class="text-danger" style="font-size:12px; margin-top:5px; display:block;">' + message + '</span>');
            $(element).after(errorSpan);
            element.classList.add('is-invalid');
        }

        function clearErrors() {
            $('.text-danger').remove();
            $('.is-invalid').removeClass('is-invalid');
        }

        function validateForm(fields) {
            let isValid = true;
            fields.forEach(field => {
                const value = document.getElementById(field.id).value.trim();
                if (!value) {
                    showError(field.id, field.message);
                    isValid = false;
                }
            });
            return isValid;
        }

        function validatePhone(elementId) {
            const phone = document.getElementById(elementId).value.trim();
            if (!phone) return true;

            const phoneRegex = /^09[0-9]{9}$/;
            if (!phoneRegex.test(phone)) {
                showError(elementId, 'شماره موبایل باید با 09 شروع و 11 رقم باشد');
                return false;
            }
            return true;
        }

        // بررسی تکراری بودن کد مشتری
        function checkDuplicateCode() {
            const code = document.getElementById('itemCode').value.trim();
            const id = document.getElementById('itemId').value;

            $('#codeError').remove();
            $('#itemCode').removeClass('is-invalid');

            if (!code) return Promise.resolve(true);

            return new Promise((resolve) => {
                $.get('/Customer/IsCodeUnique', { code: code, id: id }, function(isUnique) {
                    if (!isUnique) {
                        const errorSpan = $('<span id="codeError" class="text-danger" style="font-size:12px; margin-top:5px; display:block;"> این کد مشتری قبلاً ثبت شده است!</span>');
                        $('#itemCode').after(errorSpan);
                        $('#itemCode').addClass('is-invalid');
                        resolve(false);
                    } else {
                        resolve(true);
                    }
                });
            });
        }

        function openCreateModal() {
            clearErrors();
            document.getElementById('modalTitle').innerText = 'تعریف مشتری جدید';
            document.getElementById('itemId').value = 0;
            document.getElementById('itemTitle').value = '';
            document.getElementById('itemCode').value = '';
            document.getElementById('itemMobile').value = '';
            document.getElementById('itemProvince').value = '';
            document.getElementById('itemCity').innerHTML = '<option value="">ابتدا استان را انتخاب کنید</option>';
            document.getElementById('itemAddress').value = '';
            modal.show()
        }

        function openEditModal(id) {
            clearErrors();
            $.get('/Customer/GetById?id=' + id, function (data) {
                document.getElementById('modalTitle').innerText = 'ویرایش مشتری';
                document.getElementById('itemId').value = data.id;
                document.getElementById('itemTitle').value = data.title;
                document.getElementById('itemCode').value = data.code;
                document.getElementById('itemMobile').value = data.mobile;
                document.getElementById('itemAddress').value = data.address;
                document.getElementById('itemProvince').value = data.province;
                loadCities(data.province, data.city);
                modal.show()
            });
        }

        function loadCities(province, selectedCity) {
            var citySelect = document.getElementById('itemCity');

            if (!province) {
                citySelect.innerHTML = '<option value="">ابتدا استان را انتخاب کنید</option>';
                return;
            }

            citySelect.innerHTML = '<option value="">در حال بارگذاری...</option>';
            $.get('/Customer/GetCities?province=' + encodeURIComponent(province), function (data) {
                citySelect.innerHTML = '<option value="">انتخاب کنید</option>';
                data.forEach(function (city) {
                    var opt = document.createElement('option');
                    opt.value = city; opt.text = city;
                    if (selectedCity && city === selectedCity) opt.selected = true;
                    citySelect.appendChild(opt);
                });
            });
        }

        async function saveItem() {
            clearErrors();

            if (!validateForm([
                {id: 'itemTitle', message: 'عنوان اجباری است'},
                {id: 'itemCode', message: 'کد اجباری است'},
                {id: 'itemMobile', message: 'شماره موبایل اجباری است'},
                {id: 'itemProvince', message: 'استان اجباری است'}
            ])) return;

            if (!validatePhone('itemMobile')) return;

            // بررسی تکراری بودن کد
            const isUnique = await checkDuplicateCode();
            if (!isUnique) {
                document.getElementById('itemCode').focus();
                return;
            }

            var id = parseInt(document.getElementById('itemId').value);
            var data = {
                id: id,
                title: document.getElementById('itemTitle').value,
                code: document.getElementById('itemCode').value,
                mobile: document.getElementById('itemMobile').value,
                province: document.getElementById('itemProvince').value,
                city: document.getElementById('itemCity').value,
                address: document.getElementById('itemAddress').value
            };
            var url = id === 0 ? '/Customer/CreateAjax' : '/Customer/EditAjax';
            $.ajax({ url: url, type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        modal.hide()
                        window.location.reload()
                    }
                    else {
                        if (result.message && result.message.includes('تکراری')) {
                            showError('itemCode', 'کد مشتری تکراری است');
                        } else {
                            alert(result.message);
                        }
                    }
                }
            });
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Customer/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            // بررسی تکراری بودن کد هنگام خروج از فیلد
            $('#itemCode').on('blur', function() {
                if ($(this).val().trim() !== '') {
                    checkDuplicateCode();
                }
            });

            // پاک کردن خطا هنگام تایپ مجدد
            $('#itemCode').on('input', function() {
                $('#codeError').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemTitle').on('input', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemMobile').on('input', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemProvince').on('change', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}