@{
    ViewData["Title"] = "ورود";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="ltr">
<head>
    <title>سیستم تولید - ورود</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Inter:300,400,500,600,700" />

    <!-- Global Stylesheets -->
    <link href="~/plugins/global/plugins.bundle.css" rel="stylesheet" type="text/css" />
    <link href="~/css/style.bundle.rtl.css" rel="stylesheet" type="text/css" />

    <style>

        .alert-error {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: rgba(220, 38, 38, 0.15);
            border: 1px solid rgba(220, 38, 38, 0.4);
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 1rem;
            color: #ff6b6b;
            font-size: 14px;
            animation: slideDown 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

            .alert-error.fade-out {
                animation: fadeOut 0.5s ease forwards;
            }

        .progress-bar-err {
            height: 3px;
            background: rgba(220, 38, 38, 0.5);
            border-radius: 2px;
            margin-top: 8px;
            animation: shrink 4s linear forwards;
            transform-origin: right;
        }

        .alert-close-btn {
            background: none;
            border: none;
            color: #ff6b6b;
            cursor: pointer;
            padding: 0;
            font-size: 16px;
            line-height: 1;
            margin-right: auto;
        }
       
       
    </style>
</head>

<body id="kt_body" class="app-blank bgi-size-cover bgi-attachment-fixed bgi-position-center bgi-no-repeat">
    <script>
        var defaultThemeMode = "light";
        var themeMode;
        if (document.documentElement) {
            if (document.documentElement.hasAttribute("data-bs-theme-mode")) {
                themeMode = document.documentElement.getAttribute("data-bs-theme-mode");
            } else {
                themeMode = localStorage.getItem("data-bs-theme") !== null ? localStorage.getItem("data-bs-theme") : defaultThemeMode;
            }
            if (themeMode === "system") {
                themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-bs-theme", themeMode);
        }
    </script>

    <div class="d-flex flex-column flex-root">
        <style>
            body {
                background-image: url('/media/auth/bg4.jpg')
            }

            [data-bs-theme="dark"] body {
                background-image: url('/media/auth/bg4.jpg');
            }
        </style>

        <div class="d-flex flex-column flex-column-fluid flex-lg-row" style="width: 400px;">

            <!-- Login Form -->
            <div class="d-flex flex-column-fluid flex-lg-row-auto justify-content-center justify-content-lg-end p-12 p-lg-20" style="margin-left: 425px;width: 600px; height: 550px; ">
                <div class="bg-body d-flex flex-column align-items-stretch flex-center rounded-4 w-md-600px p-20">
                    <div class="d-flex flex-center flex-column flex-column-fluid px-lg-10 pb-15 pb-lg-20">

                        <form class="form w-100" method="post" asp-action="Login" asp-controller="Account" novalidate="novalidate" style="margin-top: 70px;">

                            <!-- Error Alert -->
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert-error" id="errorBox">
                                    <i class="fa fa-exclamation-circle" style="margin-top:2px; flex-shrink:0;"></i>
                                    <div style="flex:1">
                                        <span>@ViewBag.Error</span>
                                        <div class="progress-bar-err"></div>
                                    </div>
                                    <button type="button" class="alert-close-btn" onclick="closeAlert()">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            }

                            <!-- Heading -->
                            <div class="text-center mb-11">
                                <h1 class="text-dark fw-bolder mb-3">ورود</h1>
                                <div class="text-gray-500 fw-semibold fs-6">به سیستم تولید خوش آمدید</div>
                            </div>


                            <!-- Username -->
                            <div class="fv-row mb-8">
                                <input type="text" name="username" placeholder="نام کاربری" autocomplete="off" class="form-control bg-transparent" required />
                            </div>

                            <!-- Password -->
                            <div class="fv-row mb-3">
                                <input type="password" id="password-field" name="password" placeholder="کلمه عبور" autocomplete="off" class="form-control bg-transparent" required />
                            </div>


                            <!-- Submit Button -->
                            <div class="d-grid mb-10">
                                <button type="submit" id="kt_sign_in_submit" class="btn btn-primary">
                                    <span class="indicator-label">ورود</span>
                                    <span class="indicator-progress">
                                        در حال ورود...
                                        <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/plugins/global/plugins.bundle.js"></script>
    <script src="~/js/scripts.bundle.js"></script>

    <script>
        // Error Alert Handling
        (function () {
            var box = document.getElementById('errorBox');
            if (!box) return;
            var timer = setTimeout(function () { closeAlert(); }, 5000);

            window.closeAlert = function () {
                box.classList.add('fade-out');
                clearTimeout(timer);
                setTimeout(function () { box.style.display = 'none'; }, 500);
            };
        })();

        // Password Toggle 
        document.querySelectorAll('.toggle-password').forEach(icon => {
            icon.addEventListener('click', function () {
                const input = document.querySelector(this.getAttribute('toggle'));
                if (input.type === "password") {
                    input.type = "text";
                    this.classList.remove('fa-eye');
                    this.classList.add('fa-eye-slash');
                } else {
                    input.type = "password";
                    this.classList.remove('fa-eye-slash');
                    this.classList.add('fa-eye');
                }
            });
        });
    </script>
</body>
</html>