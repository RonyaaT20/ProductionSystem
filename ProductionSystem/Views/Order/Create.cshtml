@{
}
@model ProductionSystem.Domain.Entities.Order

@{
    ViewData["Title"] = "ثبت سفارش";
}

<h4>ثبت سفارش جدید</h4>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">عنوان سفارش</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">کد سفارش</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">مشتری</label>
        <select asp-for="CustomerId" class="form-select">
            <option value="">انتخاب کنید</option>
            @foreach (var customer in ViewBag.Customers)
            {
                <option value="@customer.Id">@customer.Title</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">کالا</label>
        <select asp-for="ProductId" class="form-select">
            <option value="">انتخاب کنید</option>
            @foreach (var product in ViewBag.Products)
            {
                <option value="@product.Id">@product.Title</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">تاریخ تحویل</label>
        <input asp-for="DeliveryDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">ذخیره</button>
    <a asp-action="Index" class="btn btn-secondary">انصراف</a>
</form>