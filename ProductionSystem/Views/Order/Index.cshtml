@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@using ProductionSystem.Application.Security
@using ProductionSystem.Application.Services
@using ProductionSystem.Application.IServices
@inject IPermissionService PermissionService

@model List<ProductionSystem.Domain.DTOs.OrderDto>

@{
    ViewData["Title"] = "سفارشات";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("تولید", "#"),
        ("سفارش", "/Order/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست سفارشات</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس عنوان ، کد ، مشتری یا کالا..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateOrder.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary" onclick="openCreateModal()">+ ثبت سفارش</button>
    }
</div>

<table class="table table-bordered table-hover" id="OrderTable">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>عنوان</th>
            <th>کد</th>
            <th>مشتری</th>
            <th>کالا</th>
            <th>تاریخ تحویل</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @{
            int row = 1;
        }
        @foreach (var o in Model)
        {
            <tr>
                <td>@(row++)</td>
                <td>@o.Title</td>
                <td>@o.Code</td>
                <td>@o.CustomerTitle</td>
                <td>@o.ProductTitle</td>
                <td>@o.DeliveryDate</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                        <ul class="dropdown-menu">
                            @if (PermissionService.CheckPermission(RoleChecker.EditOrder.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item" href="#" onclick="openEditModal(@o.Id)">ویرایش</a></li>
                            }
                            @if (PermissionService.CheckPermission(RoleChecker.DeleteOrder.ToValue(), User.GetUserId()))
                            {
                                <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@o.Id)">حذف</a></li>

                            }
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="itemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">ثبت سفارش</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="itemId" value="0" />
                <div class="mb-3"><label class="form-label">عنوان</label><input type="text" id="itemTitle" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">کد سفارش</label><input type="text" id="itemCode" class="form-control" /></div>
                <div class="mb-3"><label class="form-label">مشتری</label><select id="itemCustomerId" class="form-select"></select></div>
                <div class="mb-3"><label class="form-label">کالا</label><select id="itemProductId" class="form-select"></select></div>
                <div class="mb-3">
                    <label class="form-label">تاریخ تحویل</label>
                    <input type="text" id="itemDeliveryDate" class="form-control persian-date" placeholder="انتخاب تاریخ" readonly />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveItem()">ذخیره</button>
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <script>
        const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#OrderTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });

        var modal = new bootstrap.Modal(document.getElementById('itemModal'));
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        var deleteId = 0;

        // ========== توابع اعتبارسنجی ==========
        function showError(elementId, message) {
            const element = document.getElementById(elementId);
            const existingError = $(element).next('.text-danger');
            if (existingError.length) existingError.remove();

            const errorSpan = $('<span class="text-danger" style="font-size:12px; margin-top:5px; display:block;">' + message + '</span>');
            $(element).after(errorSpan);
            element.classList.add('is-invalid');
        }

        function clearErrors() {
            $('.text-danger').remove();
            $('.is-invalid').removeClass('is-invalid');
        }

        function validateForm(fields) {
            let isValid = true;

            for (let field of fields) {
                let element = document.getElementById(field.id);
                let value = element ? element.value.trim() : '';

                if (value === '' || value === '0') {
                    showError(field.id, field.message);
                    isValid = false;
                } else {
                    // پاک کردن خطا اگر فیلد پر شده
                    element.classList.remove('is-invalid');
                    const existingError = $(element).next('.text-danger');
                    if (existingError.length) existingError.remove();
                }
            }

            return isValid;
        }

        // ========== بررسی کد تکراری ==========
        function checkDuplicateCode() {
            const code = document.getElementById('itemCode').value.trim();
            const id = document.getElementById('itemId').value;

            $('#codeError').remove();
            $('#itemCode').removeClass('is-invalid');

            if (!code) return Promise.resolve(true);

            return new Promise((resolve) => {
                $.get('/Order/IsCodeUnique', { code: code, id: id }, function(isUnique) {
                    if (!isUnique) {
                        const errorSpan = $('<span id="codeError" class="text-danger" style="font-size:12px; margin-top:5px; display:block;"> این کد سفارش قبلاً ثبت شده است!</span>');
                        $('#itemCode').after(errorSpan);
                        $('#itemCode').addClass('is-invalid');
                        resolve(false);
                    } else {
                        resolve(true);
                    }
                }).fail(function() {
                    resolve(true); // در صورت خطای شبکه، اجازه ثبت بدهیم
                });
            });
        }

        // ========== توابع اصلی ==========
        function loadDropdowns(selectedCustomerId, selectedProductId) {
            $.get('/Customer/GetAllJson', function (data) {
                var sel = document.getElementById('itemCustomerId');
                sel.innerHTML = '<option value="">انتخاب کنید</option>';
                data.forEach(function (c) {
                    var opt = document.createElement('option');
                    opt.value = c.id; opt.text = c.title;
                    if (selectedCustomerId && c.id == selectedCustomerId) opt.selected = true;
                    sel.appendChild(opt);
                });
            });
            $.get('/Product/GetAllJson', function (data) {
                var sel = document.getElementById('itemProductId');
                sel.innerHTML = '<option value="">انتخاب کنید</option>';
                data.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.id; opt.text = p.title;
                    if (selectedProductId && p.id == selectedProductId) opt.selected = true;
                    sel.appendChild(opt);
                });
            });
        }

        function openCreateModal() {
            clearErrors();
            document.getElementById('modalTitle').innerText = 'ثبت سفارش جدید';
            document.getElementById('itemId').value = 0;
            document.getElementById('itemTitle').value = '';
            document.getElementById('itemCode').value = '';
            document.getElementById('itemDeliveryDate').value = '';
            loadDropdowns(null, null);
            modal.show();
            setTimeout(function() { initDatePickers(); }, 300);
        }

        function openEditModal(id) {
            clearErrors();
            $.get('/Order/GetById?id=' + id, function (data) {
                document.getElementById('modalTitle').innerText = 'ویرایش سفارش';
                document.getElementById('itemId').value = data.id;
                document.getElementById('itemTitle').value = data.title;
                document.getElementById('itemCode').value = data.code;
                document.getElementById('itemDeliveryDate').value = data.deliveryDate ? data.deliveryDate.substring(0, 10) : '';
                loadDropdowns(data.customerId, data.productId);
                modal.show();
                setTimeout(function() { initDatePickers(); }, 300);
            });
        }

        // ========== تابع saveItem اصلاح شده ==========
        async function saveItem() {
            clearErrors();

            // اعتبارسنجی فیلدها
            const fields = [
                {id: 'itemTitle', message: 'عنوان اجباری است'},
                {id: 'itemCode', message: 'کد اجباری است'},
                {id: 'itemCustomerId', message: 'مشتری اجباری است'},
                {id: 'itemProductId', message: 'کالا اجباری است'},
                {id: 'itemDeliveryDate', message: 'تاریخ تحویل اجباری است'}
            ];

            if (!validateForm(fields)) return;

            // بررسی کد تکراری
            const isUnique = await checkDuplicateCode();
            if (!isUnique) {
                document.getElementById('itemCode').focus();
                return;
            }

            var id = parseInt(document.getElementById('itemId').value);
            var data = {
                id: id,
                title: document.getElementById('itemTitle').value.trim(),
                code: document.getElementById('itemCode').value.trim(),
                customerId: parseInt(document.getElementById('itemCustomerId').value),
                productId: parseInt(document.getElementById('itemProductId').value),
                deliveryDate: document.getElementById('itemDeliveryDate').value
            };

            var url = id === 0 ? '/Order/CreateAjax' : '/Order/EditAjax';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        modal.hide();
                        window.location.reload();
                    } else {
                        if (result.message && result.message.includes('تکراری')) {
                            showError('itemCode', 'کد سفارش تکراری است');
                        } else {
                            Swal.fire('خطا', result.message || 'خطا در ذخیره سازی', 'error');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error:', error);
                    Swal.fire('خطا', 'خطا در ارتباط با سرور', 'error');
                }
            });
        }

        // ========== تابع حذف ==========
        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Order/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }

        // ========== رویدادهای بررسی لحظه‌ای ==========
        $(document).ready(function() {
            // بررسی کد هنگام خروج از فیلد
            $('#itemCode').on('blur', function() {
                if ($(this).val().trim() !== '') {
                    checkDuplicateCode();
                }
            });

            // پاک کردن خطا هنگام تایپ مجدد
            $('#itemCode').on('input', function() {
                $('#codeError').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemTitle').on('input', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemCustomerId').on('change', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });

            $('#itemProductId').on('change', function() {
                $(this).next('.text-danger').remove();
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}