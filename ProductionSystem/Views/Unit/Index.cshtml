@using ProductionSystem.Application.IServices
@using ProductionSystem.Application.Security
@using ProductionSystem.Domain.DTOs
@using ProductionSystem.Domain.Utilities
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model List<ProductionSystem.Domain.DTOs.UnitDto>
@inject IPermissionService PermissionService
@{
    ViewData["Title"] = "واحدها";
    ViewData["Breadcrumb"] = new List<(string, string)>
    {
        ("خانه", "/Home/Index"),
        ("اطلاعات پایه", "#"),
        ("واحد", "/Unit/Index")
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>لیست واحدها</h4>
    <input type="text" id="searchInput" placeholder="جستجو بر اساس عنوان ، مقداری/شمارشی ، تعداد اعشار ، ایجاد کننده ، یا تاریخ ایجاد..." style="  width: 560px; padding: 12px; font-size: 16px; border-radius: 12px; border: 2px solid #1470b8; margin-bottom: 20px; outline: none; margin-left: 60px; text-align: center; color: #1470b8; margin-top:20px; background-color:transparent; height:45px;">
    @if (PermissionService.CheckPermission(RoleChecker.CreateUnit.ToValue(), User.GetUserId()))
    {
        <button class="btn btn-primary"
                onclick="openCreateModal()"
                data-bs-toggle="modal"
                data-bs-target="#unitModal">
            + تعریف واحد
        </button>
    }


</div>

<table class="table table-bordered table-hover" id="UnitTable">
    <thead>
        <tr>
            <th>ردیف</th>
            <th>عنوان</th>
            <th>مقداری/شمارشی</th>
            <th>تعداد اعشار</th>
            <th>ایجادکننده</th>
            <th>تاریخ ایجاد</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @{
            int row = 1;
        }
        @foreach (var unit in Model)
        {
            <tr>
                <td>@(row++)</td>
                <td>@unit.Title</td>
                <td>@(unit.UnitKind == ProductionSystem.Domain.Entities.UnitType.Quantitative ? "مقداری" : "شمارشی")</td>
                <td>@unit.DecimalPlaces</td>
                <td>@unit.CreatedBy</td>
                <td>@unit.CreatedAt</td>
                <td>
                    @{
                        var canEdit = PermissionService.CheckPermission(RoleChecker.EditUnit.ToValue(), User.GetUserId());
                        var canDelete = PermissionService.CheckPermission(RoleChecker.DeleteUnit.ToValue(), User.GetUserId());
                    }

                    @if (canEdit || canDelete)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-light" data-bs-toggle="dropdown">⋮</button>
                            <ul class="dropdown-menu">
                                @if (canEdit)
                                {
                                    <li><a class="dropdown-item" href="#" onclick="openEditModal(@unit.Id)">ویرایش</a></li>
                                }
                                @if (canDelete)
                                {
                                    <li><a class="dropdown-item text-danger" href="#" onclick="deleteItem(@unit.Id)">حذف</a></li>
                                }
                            </ul>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="unitModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">تعریف واحد</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="unitId" value="0" />
                <div class="mb-3">
                    <label class="form-label">عنوان</label>
                    <input type="text" id="unitTitle" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">مقداری / شمارشی</label>
                    <select id="unitKind" class="form-select">
                        <option value="0">مقداری</option>
                        <option value="1">شمارشی</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">تعداد رقم اعشار</label>
                    <input type="number" id="unitDecimal" class="form-control" min="0" max="6" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="saveUnit()">ذخیره</button>

            </div>
        </div>
    </div>

</div>




@section Scripts
{
    <script>
                const searchInput = document.getElementById("searchInput");
        const rows = document.querySelectorAll("#UnitTable tbody tr");

        searchInput.addEventListener("keyup", function () {
            const value = this.value.toLowerCase();

            rows.forEach(row => {
                const rowText = row.innerText.toLowerCase();

                if (rowText.includes(value)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        });
        function setDeleteId(id) {
            $("#deleteId").val(id);
            console.log("deleteId set:", $("#deleteId").val());
        }

        function confirmDelete() {
            const id = parseInt($("#deleteId").val()) || 0;
            console.log("sending deleteId:", id);

            $.ajax({
                url: '/Unit/DeleteAjax',
                type: 'POST',
                data: { id: id },
                success: function (result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('خطا: ' + result.message);
                    }
                },
                error: function () {
                    alert('خطا در ارتباط با سرور');
                }
            });
        }

        function openCreateModal() {
            $("#modalTitle").text("تعریف واحد جدید");
            $("#unitId").val(0);
            $("#unitTitle").val("");
            $("#unitType").val("");
            $("#unitKind").val(0);
            $("#unitDecimal").val(0);
        }

        function openEditModal(id) {
            $.ajax({
                url: '/Unit/GetById',
                type: 'GET',
                data: { id: id },
                success: function (data) {
                    $("#modalTitle").text("ویرایش واحد");
                    $("#unitId").val(data.id);
                    $("#unitTitle").val(data.title);
                    $("#unitKind").val(data.unitKind);
                    $("#unitDecimal").val(data.decimalPlaces);
                },
                error: function () {
                    alert('خطا در دریافت اطلاعات واحد');
                }
            });
        }

        function saveUnit() {
             if (!validateForm([
                 {id: 'unitTitle', message: 'عنوان اجباری است'},
                 // {id: 'unitType', message: 'نوع اجباری است'}
             ])) return;
            const id = parseInt($("#unitId").val()) || 0;

            const data = {
                id: id,
                title: $("#unitTitle").val(),
                unitKind: parseInt($("#unitKind").val()) || 0,
                decimalPlaces: parseInt($("#unitDecimal").val()) || 0
            };

            const url = id === 0 ? '/Unit/CreateAjax' : '/Unit/EditAjax';

            $.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function (result) {
                    if (result.success) {
                        location.reload();
                    } else {
                        alert('خطا: ' + result.message);
                    }
                },
                error: function () {
                    alert('خطا در ذخیره اطلاعات');
                }
            });
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات قابل بازگشت نیست!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Unit/DeleteAjax', { id: id }, function (result) {
                        if (result.success) {
                            Swal.fire('حذف شد!', '', 'success').then(() => location.reload());
                        } else {
                            Swal.fire('امکان حذف وجود ندارد', result.message, 'error');
                        }
                    });
                }
            });
        }
    </script>

}
